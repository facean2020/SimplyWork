<?xml version="1.0" encoding="utf-8"?>
<!--
  图标主体：一支笔 + 字母 S 的叠加（用户定调，先用矢量画着，后续可替换为精修图）。

  构图：S 用墨色骨架居中，笔以 45° 斜压在 S 上、笔尖朝左下 —— 读作"用笔写"。
  自适应图标只有中心 ~66dp 的圆保证可见，所以所有关键点都落在以 (54,54) 为心、
  半径 33 的圆内（最外的笔尾 ≈24.8、笔尖 ≈30）。
  颜色取自 ui/theme/Color.kt：墨 #1F2226 / 墨青 #2E6B5F / 纸白 #F7F6F2。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 字母 S：一条描边的骨架曲线（比两个圆交接更接近字体的 S 中轴）。 -->
    <path
        android:pathData="M71.25,41 C71.25,33 62.05,29 54,29 C44.8,29 37.9,34 37.9,41 C37.9,48 43.65,51 54,53 C64.35,55 71.25,59 71.25,66 C71.25,74 63.2,79 54,79 C44.8,79 37.35,74 37.35,66"
        android:strokeColor="#1F2226"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 笔：笔尖(36,78) + 笔身，沿 45° 轴延伸，斜压过 S 的下半。
         笔身刻意比 S 的笔画细一档（10.4 vs 8）——再宽就把 S 的下半整个吞掉，
         缩到 48dp 只剩一团墨绿。 -->
    <path
        android:fillColor="#2E6B5F"
        android:pathData="M36,78 L48.87,71.07 L76.45,44.91 L69.09,37.55 L42.93,65.13 Z" />

    <!-- 笔缝：用纸色在笔尖上划一道（笔尖 → 笔身），否则笔尖读不出来。 -->
    <path
        android:pathData="M36,78 L45.19,68.81"
        android:strokeColor="#F7F6F2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
</vector>
