<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- systemops: notification posting + C4 notification fallback (runtime, C5) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- systemops: calendar DIRECT_WRITE mode + sys_calendar_query (v1.2) (runtime;
         EDITOR_INTENT insert needs none) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- systemops: C4 background activity launch exemption when granted via Settings -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Model provider traffic (OpenAI-compatible HTTP): normal permission, auto-granted.
         NOTE: was missing until 2026-09-10 — first real network call (listModels) crashed
         with SecurityException because OkHttp rethrows non-IOException to the pool thread. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sideloading distribution: skip per-<queries> package-visibility whack-a-mole for
         resolveActivity / getLaunchIntentForPackage against arbitrary targets. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- v1.6：Agent 任务在前台服务上执行（AgentRunService）。FGS 本体权限 + specialUse 类型权限，
         两者都是 normal 权限，install 时授予。specialUse 自 API 34 起可用，与本工程 minSdk 一致。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- sys_device_read (v1.2): ConnectivityManager.getActiveNetwork / getNetworkCapabilities.
         Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- sys_location_read (v1.2): runtime permissions, requested by the UI layer only (P4).
         APPROXIMATE needs coarse; PRECISE adds fine. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Location is a preference, not a hard requirement: sys_location_read degrades to
         security_blocked when no provider is enabled. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".SimplyWorkApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimplyWork">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SimplyWork"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${applicationId}"
                    android:path="/${msalSignatureHash}"
                    android:scheme="msauth" />
            </intent-filter>
        </activity>

        <!-- v1.6：Agent 任务执行的前台服务。只做保活 + 通知投影，不执行任何逻辑
             （run 由进程级 AgentRunSupervisor 驱动，见 core/AgentRunSupervisor.kt）。
             specialUse：任务执行不属于 dataSync/mediaPlayback 等既有类型，按平台要求
             用 specialUse 并在 property 里声明具体用途（Play 上架需填同一说明；
             本工程是 sideload 分发，声明本身无副作用）。 -->
        <service
            android:name=".service.AgentRunService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="agent_task_execution" />
        </service>
    </application>

</manifest>