<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- systemops: notification posting + C4 notification fallback (runtime, C5) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- systemops: calendar DIRECT_WRITE mode + sys_calendar_query (v1.2) (runtime;
         EDITOR_INTENT insert needs none) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- systemops: C4 background activity launch exemption when granted via Settings -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Model provider traffic (OpenAI-compatible HTTP): normal permission, auto-granted.
         NOTE: was missing until 2026-09-10 — first real network call (listModels) crashed
         with SecurityException because OkHttp rethrows non-IOException to the pool thread. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sideloading distribution: skip per-<queries> package-visibility whack-a-mole for
         resolveActivity / getLaunchIntentForPackage against arbitrary targets. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- sys_device_read (v1.2): ConnectivityManager.getActiveNetwork / getNetworkCapabilities.
         Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- sys_location_read (v1.2): runtime permissions, requested by the UI layer only (P4).
         APPROXIMATE needs coarse; PRECISE adds fine. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Location is a preference, not a hard requirement: sys_location_read degrades to
         security_blocked when no provider is enabled. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".SimplyWorkApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimplyWork">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SimplyWork"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OneDrive OAuth 回调（MSAL Android）。MSAL Android 的回调地址是
             `msauth://<包名>/<URL 编码后的签名哈希>`，不是 `msal<clientId>://auth`
             （后者是 MSAL.NET 的形式，在 Android 上属 legacy）。
             host 由 AGP 的 ${applicationId} 占位符给出；path 用**未编码**哈希，由
             gradle.properties / debug keystore 经 manifestPlaceholders 注入。
             内置 WebView 流程其实在进程内截获回调、不需要这个 filter，但声明它的
             代价为零，且能同时支持系统浏览器流程。 -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${applicationId}"
                    android:path="/${msalSignatureHash}"
                    android:scheme="msauth" />
            </intent-filter>
        </activity>
    </application>

</manifest>