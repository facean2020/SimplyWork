<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- systemops: notification posting + C4 notification fallback (runtime, C5) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- systemops: calendar DIRECT_WRITE mode + sys_calendar_query (v1.2) (runtime;
         EDITOR_INTENT insert needs none) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- systemops: C4 background activity launch exemption when granted via Settings -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Model provider traffic (OpenAI-compatible HTTP): normal permission, auto-granted.
         NOTE: was missing until 2026-09-10 — first real network call (listModels) crashed
         with SecurityException because OkHttp rethrows non-IOException to the pool thread. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sideloading distribution: skip per-<queries> package-visibility whack-a-mole for
         resolveActivity / getLaunchIntentForPackage against arbitrary targets. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- v1.6: Agent tasks execute on a foreground service (AgentRunService). The FGS permission proper + the specialUse type permission,
         both are normal permissions, granted at install time. specialUse has been available since API 34, same as this project's minSdk. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- sys_device_read (v1.2): ConnectivityManager.getActiveNetwork / getNetworkCapabilities.
         Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- sys_location_read (v1.2): runtime permissions, requested by the UI layer only (P4).
         APPROXIMATE needs coarse; PRECISE adds fine. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Location is a preference, not a hard requirement: sys_location_read degrades to
         security_blocked when no provider is enabled. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".SimplyWorkApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimplyWork">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SimplyWork"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${applicationId}"
                    android:path="/${msalSignatureHash}"
                    android:scheme="msauth" />
            </intent-filter>
        </activity>

        <!-- v1.7 external preview: the sandbox lives in private storage, so "open this wav/png with another app" can
             only work through a FileProvider content:// URI + a temporary read grant (res/xml/file_paths.xml pins the
             exportable subtree to agent_workspace/). exported=false: no other app can pull from us unprompted, the
             grant is what opens the door, per file, per launch. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- v1.6: the foreground service that runs Agent tasks. It only keeps things alive + projects the notification, executes no logic
             (the run is driven by the process-level AgentRunSupervisor, see core/AgentRunSupervisor.kt).
             specialUse: task execution isn't one of the existing types like dataSync/mediaPlayback, so per platform requirements
             we use specialUse and declare the concrete purpose in a property (Play submissions must state the same thing;
             this project ships via sideload, so the declaration itself has no side effect). -->
        <service
            android:name=".service.AgentRunService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="agent_task_execution" />
        </service>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>